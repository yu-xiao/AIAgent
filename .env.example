AI_AGENT_ENVIRONMENT=development
AI_AGENT_HOST=127.0.0.1
AI_AGENT_PORT=8000
AI_AGENT_LOG_LEVEL=INFO

# P1 platform runtime. Keep disabled until PostgreSQL, Redis, OIDC and model are configured.
AI_AGENT_PLATFORM__ENABLED=false
AI_AGENT_PLATFORM__DATABASE_URL=postgresql+asyncpg://ai_agent:change-me@localhost:5432/ai_agent
AI_AGENT_PLATFORM__DATABASE_PASSWORD_FILE=
AI_AGENT_PLATFORM__REDIS_URL=redis://localhost:6379/0
AI_AGENT_PLATFORM__REDIS_PASSWORD_FILE=
AI_AGENT_PLATFORM__RUNS_ENABLED=true
AI_AGENT_PLATFORM__SESSION_TTL_SECONDS=28800
AI_AGENT_PLATFORM__OAUTH_TRANSACTION_TTL_SECONDS=600
AI_AGENT_PLATFORM__SESSION_COOKIE_NAME=ai_agent_session
AI_AGENT_PLATFORM__POST_LOGIN_REDIRECT_URI=http://localhost:8000/docs
AI_AGENT_PLATFORM__EXTERNAL_CONNECTION_REDIRECT_URI=http://localhost:8000/api/v1/connections/{server_code}/callback
AI_AGENT_POSTGRES_PASSWORD=change-me

# P1 model values are intentionally empty. Add them locally; never commit API keys.
AI_AGENT_MODEL__ENABLED=false
AI_AGENT_MODEL__BASE_URL=
AI_AGENT_MODEL__MODEL=
AI_AGENT_MODEL__API_KEY=
AI_AGENT_MODEL__API_KEY_FILE=
AI_AGENT_MODEL__REQUEST_TIMEOUT_SECONDS=60
AI_AGENT_MODEL__INPUT_PRICE_PER_MILLION_TOKENS=0
AI_AGENT_MODEL__OUTPUT_PRICE_PER_MILLION_TOKENS=0
AI_AGENT_MODEL__SYSTEM_PROMPT=You are a concise enterprise assistant.

# Initial hard run limits from the implementation plan.
AI_AGENT_LIMITS__MAX_QUESTION_CHARACTERS=4000
AI_AGENT_LIMITS__MAX_MODEL_ROUNDS=6
AI_AGENT_LIMITS__MAX_TOOL_CALLS=10
AI_AGENT_LIMITS__MAX_RUN_SECONDS=90
AI_AGENT_LIMITS__MAX_INPUT_TOKENS=16000
AI_AGENT_LIMITS__MAX_OUTPUT_TOKENS=2048
AI_AGENT_LIMITS__MAX_COST_USD=1

# Independent Agent identity provider. Use a dedicated Keycloak realm or another OIDC provider.
AI_AGENT_OIDC__ENABLED=false
AI_AGENT_OIDC__ISSUER=http://localhost:8081/realms/ai-agent
AI_AGENT_OIDC__CLIENT_ID=ai-agent-web
AI_AGENT_OIDC__CLIENT_SECRET=
AI_AGENT_OIDC__TOKEN_ENDPOINT_AUTH_METHOD=none
AI_AGENT_OIDC__REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
AI_AGENT_OIDC__SCOPE=openid profile email
AI_AGENT_OIDC__SIGNING_ALGORITHMS=["RS256"]

# PermissionSystem is the first external account connection and MCP integration.
AI_AGENT_PERMISSION_SYSTEM__ENABLED=false
AI_AGENT_PERMISSION_SYSTEM__MCP_URL=http://localhost:5071/mcp
AI_AGENT_PERMISSION_SYSTEM__TOKEN_URL=http://localhost:5264/connect/token
AI_AGENT_PERMISSION_SYSTEM__SCOPE=permission-system-mcp
AI_AGENT_PERMISSION_SYSTEM__AUTHORIZATION_CLIENT_ID=
AI_AGENT_PERMISSION_SYSTEM__AUTHORIZATION_CLIENT_SECRET=
AI_AGENT_PERMISSION_SYSTEM__TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
AI_AGENT_PERMISSION_SYSTEM__REDIRECT_URI=http://localhost:8000/api/v1/connections/permission-system/callback

# P0 live MCP probe: configure either a short-lived access token or a service client.
AI_AGENT_PERMISSION_SYSTEM__ACCESS_TOKEN=
AI_AGENT_PERMISSION_SYSTEM__SERVICE_CLIENT_ID=
AI_AGENT_PERMISSION_SYSTEM__SERVICE_CLIENT_SECRET=
AI_AGENT_PERMISSION_SYSTEM__REQUEST_TIMEOUT_SECONDS=10

# P2 MCP Gateway defaults. Keep disabled until trusted servers are registered.
AI_AGENT_MCP_GATEWAY__ENABLED=false
AI_AGENT_MCP_GATEWAY__CATALOG_TTL_SECONDS=300
AI_AGENT_MCP_GATEWAY__DEFAULT_TIMEOUT_SECONDS=10
AI_AGENT_MCP_GATEWAY__MAX_RESPONSE_BYTES=1000000
AI_AGENT_MCP_GATEWAY__RATE_LIMIT_PER_MINUTE=60
AI_AGENT_MCP_GATEWAY__MAX_CONCURRENCY=20
AI_AGENT_MCP_GATEWAY__CIRCUIT_BREAKER_THRESHOLD=3
AI_AGENT_MCP_GATEWAY__CIRCUIT_BREAKER_RECOVERY_SECONDS=30
AI_AGENT_MCP_GATEWAY__ALLOW_LOCAL_ADDRESSES=true
AI_AGENT_MCP_GATEWAY__ALLOW_PRIVATE_ADDRESSES=false
AI_AGENT_MCP_GATEWAY__ALLOWED_HOSTS=[]
AI_AGENT_MCP_GATEWAY__ALLOWED_IPS=[]

# P5 production governance. Development keeps the in-memory Vault and quotas disabled.
AI_AGENT_CREDENTIALS__BACKEND=memory
AI_AGENT_CREDENTIALS__ADDRESS=
AI_AGENT_CREDENTIALS__MOUNT_PATH=secret
AI_AGENT_CREDENTIALS__PATH_PREFIX=ai-agent/credentials
AI_AGENT_CREDENTIALS__TOKEN_FILE=
AI_AGENT_CREDENTIALS__NAMESPACE=
AI_AGENT_CREDENTIALS__REQUEST_TIMEOUT_SECONDS=5

AI_AGENT_GOVERNANCE__ENABLED=false
AI_AGENT_GOVERNANCE__MAX_REQUEST_BODY_BYTES=1048576
AI_AGENT_GOVERNANCE__SHUTDOWN_GRACE_SECONDS=30
AI_AGENT_GOVERNANCE__STALE_RUN_AFTER_SECONDS=300
AI_AGENT_GOVERNANCE__AUDIT_INTEGRITY_KEY_FILE=
AI_AGENT_GOVERNANCE__AUDIT_INTEGRITY_KEY_ID=v1
AI_AGENT_GOVERNANCE__AUDIT_RETENTION_DAYS=365
AI_AGENT_GOVERNANCE__MAX_CONCURRENT_RUNS=20

# Durable execution. Development defaults to embedded; production requires external_worker.
AI_AGENT_EXECUTION__MODE=embedded
AI_AGENT_EXECUTION__LEASE_SECONDS=45
AI_AGENT_EXECUTION__HEARTBEAT_SECONDS=10
AI_AGENT_EXECUTION__WORKER_STALE_SECONDS=30
AI_AGENT_EXECUTION__POLL_INTERVAL_SECONDS=1
AI_AGENT_EXECUTION__RETRY_DELAY_SECONDS=2
AI_AGENT_EXECUTION__RETRY_MAX_DELAY_SECONDS=60
AI_AGENT_EXECUTION__RETRY_JITTER_RATIO=0.2
AI_AGENT_EXECUTION__MAX_ATTEMPTS=3

# Managed Agent control plane: legacy, managed_optional, or managed_required.
AI_AGENT_AGENT_CONTROL__MODE=legacy
AI_AGENT_EVALUATION__GATE_MODE=advisory
AI_AGENT_EVALUATION__MAX_CONCURRENT_RUNS=2
AI_AGENT_EVALUATION__MAX_CASES_PER_DATASET=200
AI_AGENT_GOVERNANCE__QUOTA__ENABLED=false
AI_AGENT_GOVERNANCE__QUOTA__MAX_CONCURRENT_RUNS_PER_USER=2
AI_AGENT_GOVERNANCE__QUOTA__MAX_CONCURRENT_RUNS_PER_ORGANIZATION=20
AI_AGENT_GOVERNANCE__QUOTA__MAX_RUNS_PER_USER_PER_MINUTE=10
AI_AGENT_GOVERNANCE__QUOTA__MAX_DAILY_TOKENS_PER_USER=1000000
AI_AGENT_GOVERNANCE__QUOTA__MAX_DAILY_TOKENS_PER_ORGANIZATION=20000000
AI_AGENT_GOVERNANCE__QUOTA__MAX_DAILY_COST_USD_PER_USER=10
AI_AGENT_GOVERNANCE__QUOTA__MAX_DAILY_COST_USD_PER_ORGANIZATION=100

AI_AGENT_OBSERVABILITY__TRACING_ENABLED=false
AI_AGENT_OBSERVABILITY__SERVICE_NAME=enterprise-ai-agent
AI_AGENT_OBSERVABILITY__OTLP_ENDPOINT=
AI_AGENT_OBSERVABILITY__TRACE_SAMPLE_RATIO=0.1
