AI_AGENT_ENVIRONMENT=development
AI_AGENT_HOST=127.0.0.1
AI_AGENT_PORT=8000
AI_AGENT_LOG_LEVEL=INFO

# Independent Agent identity provider. Use a dedicated Keycloak realm or another OIDC provider.
AI_AGENT_OIDC__ENABLED=false
AI_AGENT_OIDC__ISSUER=http://localhost:8081/realms/ai-agent
AI_AGENT_OIDC__CLIENT_ID=ai-agent-web
AI_AGENT_OIDC__CLIENT_SECRET=
AI_AGENT_OIDC__TOKEN_ENDPOINT_AUTH_METHOD=none
AI_AGENT_OIDC__REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
AI_AGENT_OIDC__SCOPE=openid profile email

# PermissionSystem is the first external account connection and MCP integration.
AI_AGENT_PERMISSION_SYSTEM__ENABLED=false
AI_AGENT_PERMISSION_SYSTEM__MCP_URL=http://localhost:5071/mcp
AI_AGENT_PERMISSION_SYSTEM__TOKEN_URL=http://localhost:5264/connect/token
AI_AGENT_PERMISSION_SYSTEM__SCOPE=permission-system-mcp
AI_AGENT_PERMISSION_SYSTEM__AUTHORIZATION_CLIENT_ID=
AI_AGENT_PERMISSION_SYSTEM__AUTHORIZATION_CLIENT_SECRET=
AI_AGENT_PERMISSION_SYSTEM__TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
AI_AGENT_PERMISSION_SYSTEM__REDIRECT_URI=http://localhost:8000/api/v1/connections/permission-system/callback

# P0 live MCP probe: configure either a short-lived access token or a service client.
AI_AGENT_PERMISSION_SYSTEM__ACCESS_TOKEN=
AI_AGENT_PERMISSION_SYSTEM__SERVICE_CLIENT_ID=
AI_AGENT_PERMISSION_SYSTEM__SERVICE_CLIENT_SECRET=
AI_AGENT_PERMISSION_SYSTEM__REQUEST_TIMEOUT_SECONDS=10

