AI_AGENT_ENVIRONMENT=production
AI_AGENT_HOST=0.0.0.0
AI_AGENT_PORT=8000
AI_AGENT_LOG_LEVEL=INFO

# HTTP boundary: replace with the public hostname and the proxy/container source CIDR.
AI_AGENT_SECURITY__ALLOWED_HOSTS=["agent.example.com"]
AI_AGENT_SECURITY__TRUSTED_PROXY_IPS=["172.20.0.0/16"]

AI_AGENT_PLATFORM__ENABLED=true
AI_AGENT_PLATFORM__DATABASE_URL=postgresql+asyncpg://ai_agent@postgres.example.internal:5432/ai_agent?ssl=require
AI_AGENT_PLATFORM__DATABASE_PASSWORD_FILE=/run/secrets/database_password
AI_AGENT_PLATFORM__REDIS_URL=rediss://redis.example.internal:6379/0
AI_AGENT_PLATFORM__REDIS_PASSWORD_FILE=/run/secrets/redis_password
AI_AGENT_PLATFORM__RUNS_ENABLED=true
AI_AGENT_PLATFORM__SESSION_COOKIE_NAME=ai_agent_session
AI_AGENT_PLATFORM__POST_LOGIN_REDIRECT_URI=https://agent.example.com/
AI_AGENT_PLATFORM__EXTERNAL_CONNECTION_REDIRECT_URI=https://agent.example.com/api/v1/connections/{server_code}/callback

AI_AGENT_MODEL__ENABLED=true
AI_AGENT_MODEL__BASE_URL=https://model.example.com/v1
AI_AGENT_MODEL__MODEL=replace-with-approved-model
AI_AGENT_MODEL__API_KEY_FILE=/run/secrets/model_api_key
AI_AGENT_MODEL__INPUT_PRICE_PER_MILLION_TOKENS=1
AI_AGENT_MODEL__OUTPUT_PRICE_PER_MILLION_TOKENS=2

AI_AGENT_OIDC__ENABLED=true
AI_AGENT_OIDC__ISSUER=https://identity.example.com/realms/ai-agent
AI_AGENT_OIDC__CLIENT_ID=ai-agent-web
AI_AGENT_OIDC__TOKEN_ENDPOINT_AUTH_METHOD=none
AI_AGENT_OIDC__REDIRECT_URI=https://agent.example.com/api/v1/auth/callback

AI_AGENT_MCP_GATEWAY__ENABLED=true
AI_AGENT_PERMISSION_SYSTEM__ENABLED=true
AI_AGENT_PERMISSION_SYSTEM__MCP_URL=https://permission-mcp.example.internal/mcp
AI_AGENT_PERMISSION_SYSTEM__TOKEN_URL=https://identity.example.internal/connect/token
AI_AGENT_PERMISSION_SYSTEM__REDIRECT_URI=https://agent.example.com/api/v1/connections/permission-system/callback

AI_AGENT_CREDENTIALS__BACKEND=hashicorp_vault
AI_AGENT_CREDENTIALS__ADDRESS=https://vault.example.internal
AI_AGENT_CREDENTIALS__MOUNT_PATH=secret
AI_AGENT_CREDENTIALS__PATH_PREFIX=ai-agent/credentials
AI_AGENT_CREDENTIALS__TOKEN_FILE=/run/secrets/vault_token

AI_AGENT_GOVERNANCE__ENABLED=true
AI_AGENT_GOVERNANCE__AUDIT_RETENTION_DAYS=365
AI_AGENT_GOVERNANCE__MAX_REQUEST_BODY_BYTES=1048576
AI_AGENT_GOVERNANCE__SHUTDOWN_GRACE_SECONDS=30
AI_AGENT_GOVERNANCE__STALE_RUN_AFTER_SECONDS=300
AI_AGENT_GOVERNANCE__AUDIT_INTEGRITY_KEY_FILE=/run/secrets/audit_integrity_key
AI_AGENT_GOVERNANCE__AUDIT_INTEGRITY_KEY_ID=v1
AI_AGENT_GOVERNANCE__QUOTA__ENABLED=true
AI_AGENT_GOVERNANCE__QUOTA__MAX_CONCURRENT_RUNS_PER_USER=2
AI_AGENT_GOVERNANCE__QUOTA__MAX_CONCURRENT_RUNS_PER_ORGANIZATION=20
AI_AGENT_GOVERNANCE__QUOTA__MAX_RUNS_PER_USER_PER_MINUTE=10
AI_AGENT_GOVERNANCE__QUOTA__MAX_DAILY_TOKENS_PER_USER=1000000
AI_AGENT_GOVERNANCE__QUOTA__MAX_DAILY_TOKENS_PER_ORGANIZATION=20000000
AI_AGENT_GOVERNANCE__QUOTA__MAX_DAILY_COST_USD_PER_USER=10
AI_AGENT_GOVERNANCE__QUOTA__MAX_DAILY_COST_USD_PER_ORGANIZATION=100

AI_AGENT_EXECUTION__MODE=external_worker
AI_AGENT_EXECUTION__LEASE_SECONDS=45
AI_AGENT_EXECUTION__HEARTBEAT_SECONDS=10
AI_AGENT_EXECUTION__WORKER_STALE_SECONDS=30
AI_AGENT_EXECUTION__POLL_INTERVAL_SECONDS=1
AI_AGENT_EXECUTION__RETRY_DELAY_SECONDS=2
AI_AGENT_EXECUTION__RETRY_MAX_DELAY_SECONDS=60
AI_AGENT_EXECUTION__RETRY_JITTER_RATIO=0.2
AI_AGENT_EXECUTION__MAX_ATTEMPTS=3

# Keep legacy until managed Agent versions are migrated and production rollout is approved.
AI_AGENT_AGENT_CONTROL__MODE=legacy
AI_AGENT_EVALUATION__GATE_MODE=off

AI_AGENT_OBSERVABILITY__TRACING_ENABLED=true
AI_AGENT_OBSERVABILITY__SERVICE_NAME=enterprise-ai-agent
AI_AGENT_OBSERVABILITY__OTLP_ENDPOINT=http://otel-collector.example.internal:4318/v1/traces
AI_AGENT_OBSERVABILITY__TRACE_SAMPLE_RATIO=0.1
